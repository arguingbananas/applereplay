# Build output, including the private SSH key (out/ssh) and the box's SSH
# host keys (out/hostkeys). Never commit these.
/out/

# The build environment: gigabytes, regenerated by env/bootstrap.sh.
/env/root/
/env/*.log
*.tar
*.tar.*

# Not ours to publish. assets/README would say where to get each:
#   atv-boot/boot.efi   Apple's, from an Apple TV update image
#   atv-boot/System     Dummy.kext, from DistroHopper39B/DummyKext
#   total-replay.hdv    Total Replay's disk image (contains commercial games)
/assets/

# Personal notes for Claude Code about this particular setup.
/CLAUDE.local.md

# Claude Code session state (worktrees, local settings).
/.claude/
