+  SrcStep(int src_w, int dst_w) : src_w(src_w), dst_w(dst_w) {}
+  int src_w;
+  int dst_w;
+  int x = 0;
+  int rem = 0;
+  auto next() -> int {
+    int cur = x;
+    rem += src_w;
+    while (rem >= dst_w) {
