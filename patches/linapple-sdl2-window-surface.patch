+// With SDL's software renderer, a frame was copied into a texture and then
+// again into the window surface. Instead, draw the frame straight into the
+// window surface; on slow CPUs without GPU acceleration this matters.
+static bool use_window_surface = false;
+// draw_frame_window drew this frame into the window surface, not screen.
+static bool frame_in_window_surface = false;
+// The part of the window surface that frame changed; empty if none of it.
+static SDL_Rect window_surface_dirty{};
+// The last frame drawn into the window surface, to find the rows that change.
+// Empty when the window surface no longer holds that frame.
+static std::vector<uint32_t> last_output;
+static int frames_since_full_update = 0;
+
+// Narrows *src and *dst to the band of rows that changed since the last frame
+// drawn into the window surface. Returns false if nothing changed. The band is
+// widened to whole blocks of rows that scale exactly (8 source rows to 15 at
+// 720 lines, 1 to 2 at 2x), so its pixels match a full redraw. It repaints
+// everything once a second regardless.
+static auto narrow_to_changed_rows(const uint32_t* output, VideoRect* src,
+                                   VideoRect* dst) -> bool {
+  const size_t pixels = static_cast<size_t>(SCREEN_WIDTH) * SCREEN_HEIGHT;
+  if (src->x != 0 || src->y != 0 || src->w != SCREEN_WIDTH ||
+      src->h != SCREEN_HEIGHT || dst->h <= 0) {
+    last_output.clear();
+    return true;
+  }
+  if (last_output.size() != pixels || ++frames_since_full_update >= 60) {
+    last_output.assign(output, output + pixels);
+    frames_since_full_update = 0;
+    return true;
+  }
+  const size_t row_bytes = SCREEN_WIDTH * sizeof(uint32_t);
+  auto row_same = [&](int y) -> bool {
+    const size_t off = static_cast<size_t>(y) * SCREEN_WIDTH;
+    return std::memcmp(output + off, last_output.data() + off, row_bytes) == 0;
+  };
+  int top = 0;
+  while (top < SCREEN_HEIGHT && row_same(top)) {
+    ++top;
+  }
+  if (top == SCREEN_HEIGHT) {
+    return false;
+  }
+  int bottom = SCREEN_HEIGHT;
+  while (bottom > top && row_same(bottom - 1)) {
+    --bottom;
+  }
+  const size_t off = static_cast<size_t>(top) * SCREEN_WIDTH;
+  std::memcpy(last_output.data() + off, output + off,
+              static_cast<size_t>(bottom - top) * row_bytes);
+  // block source rows become dst_block destination rows, exactly.
+  int a = dst->h;
+  int b = SCREEN_HEIGHT;
+  while (b != 0) {
+    const int t = a % b;
+    a = b;
+    b = t;
+  }
+  const int block = SCREEN_HEIGHT / a;
+  const int dst_block = dst->h / a;
+  top -= top % block;
+  bottom += (block - bottom % block) % block;
+  src->y = top;
+  src->h = bottom - top;
+  dst->y += top / block * dst_block;
+  dst->h = (bottom - top) / block * dst_block;
+  return true;
+}
+
+// The window surface to draw a frame into directly, if its pixels match
+// screen's (32-bit 0x00RRGGBB), else nullptr.
+static auto direct_window_surface() -> SDL_Surface* {
+  if (!use_window_surface || window == nullptr || screen == nullptr) {
+    return nullptr;
+  }
+  SDL_Surface* ws = SDL_GetWindowSurface(window.get());
+  if (ws == nullptr || ws->w != screen->w || ws->h != screen->h ||
+      (ws->format->format != SDL_PIXELFORMAT_RGB888 &&
+       ws->format->format != SDL_PIXELFORMAT_ARGB8888)) {
+    return nullptr;
+  }
+  return ws;
+}
